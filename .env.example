# Copie este arquivo para ".env" e ajuste.

# Conexão com o PostgreSQL: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgres://obras:troque-esta-senha@localhost:5432/obras
# Supabase: Project Settings > Database > Connection string > "Session pooler" (URI), com a senha do banco:
# DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA-DO-BANCO@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Porta do sistema (http://localhost:3000)
PORT=3000

# Horas até o login expirar
SESSAO_HORAS=12

# Em produção (servidor com HTTPS), descomente:
# NODE_ENV=production
# COOKIE_SECURE=1
# Se estiver atrás de proxy (Nginx, Caddy, Render, Railway...), informe quantos proxies há na frente:
# TRUST_PROXY=1
